{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "almanyapusulasi",
  "main": "worker.mjs",
  "compatibility_date": "2026-06-16",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
